# API origin used by the standalone dashboard.
# Local development: leave empty; Vite proxies /api/ to http://localhost:3001.
VITE_API_BASE_URL=

# Separate production deployment: set this at build time to the storefront/API
# HTTPS origin, with no trailing slash (for example https://shop.example.com).
# The API's ADMIN_ALLOWED_ORIGINS must include the dashboard's exact origin.
# VITE_API_BASE_URL=https://shop.example.com
