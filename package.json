{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "dashboard-cherrycreamsoda"
  ],
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --port=3000 --host=0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "seed": "node server/seed-products.js",
    "test": "node --test",
    "build": "npm run build:storefront && npm run build:dashboard",
    "build:storefront": "node ./node_modules/vite/bin/vite.js build",
    "build:dashboard": "npm run build --workspace=project-dashboard -- --base=/dashboard/ --outDir=../public/dashboard --emptyOutDir",
    "build:backend": "node -e \"process.exit(0)\"",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"for(const path of ['dist','public'])require('node:fs').rmSync(path,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@firebase/app": "^0.16.5",
    "@firebase/auth": "^1.13.9",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.21.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3"
  }
}
