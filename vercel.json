{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build:storefront",
      "outputDirectory": "public",
      "functions": {
        "api/**/*.js": {
          "includeFiles": "Data/imgs/**"
        }
      }
    },
    "dashboard": {
      "root": "dashboard-cherrycreamsoda",
      "framework": "vite",
      "buildCommand": "npm run build -- --base=/dashboard/",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "dashboard",
        "path": "/"
      }
    },
    {
      "source": "/dashboard/:path*",
      "destination": {
        "service": "dashboard",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
