{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build:storefront",
      "outputDirectory": "public"
    },
    "dashboard": {
      "root": "dashboard-cherrycreamsoda",
      "framework": "vite",
      "buildCommand": "npm run build -- --base=/dashboard/",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/index.js",
      "buildCommand": "npm run build:backend",
      "devCommand": "npm run dev:server",
      "functions": {
        "api/**/*.js": {
          "includeFiles": "Data/imgs/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend",
        "path": "/api/:path*"
      }
    },
    {
      "source": "/dashboard/assets/:path*",
      "destination": {
        "service": "dashboard",
        "path": "/assets/:path*"
      }
    },
    {
      "source": "/dashboard",
      "destination": {
        "service": "dashboard",
        "path": "/index.html"
      }
    },
    {
      "source": "/dashboard/:path*",
      "destination": {
        "service": "dashboard",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
