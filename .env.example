# Copy this file to .env, then replace every CHANGE_ME value.
# Never commit .env or put server secrets in VITE_* variables.

# MongoDB Atlas connection string for the application's database.
# Create a restricted database user; URL-encode special characters in its password.
MONGODB_URI=mongodb+srv://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_CLUSTER/ha_perfume_house?retryWrites=true&w=majority
# Optional database name. Defaults to ha_perfume_house.
MONGODB_DB=ha_perfume_house

# Admin credentials used by both the storefront admin and standalone dashboard.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_UNIQUE_STRONG_PASSWORD
# HMAC signing secret for the HTTP-only admin session cookie; at least 32 bytes.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Firebase Web App settings (public client config; Firebase Console > Project settings > General).
# These are embedded in the frontend build, so they must not contain private credentials.
VITE_FIREBASE_API_KEY=CHANGE_ME_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=CHANGE_ME_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=CHANGE_ME_PROJECT_ID
VITE_FIREBASE_APP_ID=CHANGE_ME_WEB_APP_ID

# Firebase project ID used by the server to verify customer ID tokens.
FIREBASE_PROJECT_ID=CHANGE_ME_PROJECT_ID
# Local option: path to a Firebase Admin SDK key stored OUTSIDE this repository.
# Replace CHANGE_ME with your Windows account folder. Never put this JSON in the project.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/CHANGE_ME/.secrets/firebase-service-account.json
# Deployment option instead of FIREBASE_SERVICE_ACCOUNT_PATH: set this server-only
# variable to the compact service-account JSON. Do not prefix it with VITE_.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact origins allowed to call the API with the admin session cookie.
# Include the standalone dashboard origin only when it is on a different origin.
# Use comma-separated origins with no trailing slash; leave empty if not needed.
ADMIN_ALLOWED_ORIGINS=

# API listen port for local development; defaults to 3001.
PORT=3001
