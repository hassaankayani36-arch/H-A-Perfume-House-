# Copy this file to .env and replace the example values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ha_perfume_house?retryWrites=true&w=majority
MONGODB_DB=ha_perfume_house

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional; defaults to 3001.
PORT=3001
